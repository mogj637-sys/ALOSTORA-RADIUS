# Copy to .env for local development. Never commit .env.
POSTGRES_DB=alostora_radius
POSTGRES_USER=alostora
POSTGRES_PASSWORD=change-this-local-development-password
DATABASE_URL=postgresql+psycopg://alostora:change-this-local-development-password@db:5432/alostora_radius
APP_ENV=development
# Generate a private random value of at least 32 characters before login.
APP_SECRET_KEY=replace-with-a-long-random-secret-before-use
JWT_ACCESS_TOKEN_MINUTES=30
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Separate encryption key for MikroTik API and RADIUS shared secrets.
ROUTER_SECRET_ENCRYPTION_KEY=replace-with-a-second-generated-fernet-key

# Internal key shared only by the FreeRADIUS container and the API service.
RADIUS_INTERNAL_API_KEY=replace-with-a-long-random-internal-key-at-least-32-chars
