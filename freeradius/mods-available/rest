rest {
    tls {
    }

    connect_uri = "http://api:8000"
    connect_timeout = 4.0

    authorize {
        uri = "${..connect_uri}/internal/radius/authorize"
        method = 'post'
        body = 'json'
        timeout = 5.0
        tls = ${..tls}
    }

    accounting {
        uri = "${..connect_uri}/internal/radius/accounting"
        method = 'post'
        body = 'json'
        force_to = 'plain'
        timeout = 5.0
        tls = ${..tls}
    }

    pool {
        start = 0
        min = 1
        max = 10
        spare = 2
        uses = 0
        retry_delay = 5
        lifetime = 0
        idle_timeout = 60
    }
}
