rest {
    authenticate {
        uri = "http://api:8000/internal/radius/authorize"
        method = 'post'
        body = 'json'
        force_to = 'json'
        timeout = 5.0
    }

    accounting {
        uri = "http://api:8000/internal/radius/accounting"
        method = 'post'
        body = 'json'
        force_to = 'plain'
        timeout = 5.0
    }
}
